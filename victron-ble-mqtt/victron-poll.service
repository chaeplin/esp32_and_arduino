[Unit]
Description=Victron daily hist + 10min PV poll
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/victron-ble-mqtt
ExecStart=/usr/bin/python3 %h/victron-ble-mqtt/victron_poll.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/victron-ble-mqtt/.env

[Install]
WantedBy=default.target
