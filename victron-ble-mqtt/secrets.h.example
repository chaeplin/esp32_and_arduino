#pragma once
/* Copy to secrets.h (same folder) and fill in. secrets.h is git-ignored — never commit it. */

#define SECRET_WIFI_SSID     "YOUR_WIFI_SSID"
#define SECRET_WIFI_PASS     "YOUR_WIFI_PASSWORD"

#define SECRET_MQTT_HOST     "YOUR_MQTT_HOST"      /* hostname or IP of the broker */
#define SECRET_MQTT_PORT     1883
#define SECRET_MQTT_USER     "YOUR_MQTT_USER"
#define SECRET_MQTT_PASS     "YOUR_MQTT_PASSWORD"
#define SECRET_MQTT_CLIENT   "huzzah-victron-gatt"

/* Victron BLE pairing PIN (6 digits, VictronConnect → product → Settings → Pin code) */
#define SECRET_VICTRON_PIN   000000u

/* Instant Readout: VictronConnect → product → ⋮ → Product info → Instant readout details → Show */
#define SECRET_MPPT_SN       "YOUR_MPPT_SERIAL"
#define SECRET_MPPT_MAC      "aabbccddeeff"        /* 12 lowercase hex chars, no colons */
#define SECRET_MPPT_AES_KEY  { 0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00 }
#define SECRET_SENSE_SN      "YOUR_SENSE_SERIAL"
#define SECRET_SENSE_MAC     "112233445566"
#define SECRET_SENSE_AES_KEY { 0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00 }

/* optional static IP (1 = use the four values below, comma separated octets) */
#define SECRET_USE_STATIC_IP 0
#define SECRET_STATIC_IP     0,0,0,0
#define SECRET_STATIC_GW     0,0,0,0
#define SECRET_STATIC_MASK   255,255,255,0
#define SECRET_STATIC_DNS    0,0,0,0
