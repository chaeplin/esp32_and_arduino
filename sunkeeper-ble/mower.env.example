# mower.env.example → mower.env 로 복사 후 값 입력 (mower.env 는 git 제외)
# 환경변수로 직접 export 해도 된다. 이미 설정된 환경변수가 우선.

# MQTT (두 스크립트 공통)
MQTT_HOST=192.168.x.x
MQTT_PORT=1883
MQTT_USER=YOUR_MQTT_USER
MQTT_PASS=YOUR_MQTT_PASSWORD

# InfluxDB v2 궤적 조회 (선택)
INFLUX_URL=http://192.168.x.x:8086
INFLUX_ORG=yard
INFLUX_BUCKET=mower
# 토큰은 여기 또는 influx.env / influx.token 에. pad 는 환경변수 또는 influx.token 만 읽음
INFLUX_TOKEN=YOUR_INFLUX_TOKEN

# mower_live_map.py: JPEG 스냅샷 URL (선택, 예: go2rtc /api/frame.jpeg?src=...)
GO2_SNAP_URL=

# mower_mqtt_pad.py: gps/rover → 로컬 좌표 변환 원점(도크 위경도, 선택)
MOWER_GPS_LAT0=0
MOWER_GPS_LON0=0
